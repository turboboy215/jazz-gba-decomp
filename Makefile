# Jazz Jackrabbit (USA) GBA decompilation (AJJE, SHA1 9fb012b4...)
# Compiler: old_agbcc (pret) -O2 -mthumb-interwork  -- see docs/STRATEGY.md "Compiler identification"
ROM     := jazz.gba
BUILD   := build
PREFIX  := arm-none-eabi-
AS      := $(PREFIX)as
LD      := $(PREFIX)ld
OBJCOPY := $(PREFIX)objcopy
CC1     := tools/agbcc/bin/old_agbcc
CPP     := $(PREFIX)cpp
ASFLAGS := -mcpu=arm7tdmi -I include
CFLAGS  := -mthumb-interwork -Wimplicit -Wparentheses -O2 -fhex-asm
# jump tables to .rodata (region A and game code); GAX keeps them inline (objects.mk sets JTBL := true)
JTBL    := python3 tools/jtbl.py

include objects.mk   # generated by tools/split.py, in link order (paths under build/)
LDSCRIPT := ld_script.ld

.PHONY: all compare clean check-baserom progress split nonmatching
all: $(ROM)

check-baserom:
	@sha1sum --quiet -c baserom.sha1 || (echo "baserom.gba missing or wrong SHA1 (copy 'Jazz Jackrabbit (U).gba' here as baserom.gba)"; exit 1)

compare: $(ROM)
	sha1sum -c jazz.sha1

$(ROM): $(BUILD)/jazz.elf
	$(OBJCOPY) -O binary $< $@

$(BUILD)/syms.ld: $(OBJS)
	python3 tools/syms.py $@ $(filter $(BUILD)/src/%,$(OBJS))

$(BUILD)/jazz.elf: $(OBJS) $(BUILD)/lib/aliases.o $(LDSCRIPT) $(BUILD)/syms.ld
	$(LD) -T $(LDSCRIPT) -Map $(BUILD)/jazz.map -o $@ $(OBJS) $(BUILD)/lib/aliases.o

$(BUILD)/%.o: %.s asm/macros.inc | check-baserom
	@mkdir -p $(dir $@)
	$(AS) $(ASFLAGS) -o $@ $<

$(BUILD)/src/%.o: src/%.c | check-baserom
	@mkdir -p $(dir $@)
	$(CPP) -nostdinc -I include -I tools/agbcc/include -MMD -MP -MF $(BUILD)/src/$*.d -MT $@ $< | $(CC1) $(CFLAGS) -o $(BUILD)/src/$*.s
	$(JTBL) $(BUILD)/src/$*.s
	@printf '\t.align 2, 0\n' >> $(BUILD)/src/$*.s
	$(AS) $(ASFLAGS) -o $@ $(BUILD)/src/$*.s

-include $(wildcard $(BUILD)/src/*.d)

split:
	python3 tools/split.py --verify

progress:
	@python3 tools/progress.py

clean:
	rm -rf $(BUILD) $(ROM)

# GAX functions decompiled but not yet matching (not linked): make sure they still compile
nonmatching:
	@mkdir -p $(BUILD)/nonmatching
	$(CPP) -nostdinc -I include -I tools/agbcc/include src/gax/nonmatching.c | tools/agbcc/bin/agbcc $(CFLAGS) -fprologue-bugfix -o $(BUILD)/nonmatching/gax.s
	$(CPP) -nostdinc -I include -I tools/agbcc/include src/nonmatching/region_a.c | tools/agbcc/bin/old_agbcc $(CFLAGS) -o $(BUILD)/nonmatching/region_a.s
