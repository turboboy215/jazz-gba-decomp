diff --git a/gcc/gcse.c b/gcc/gcse.c
index 9c82ab6..4327fb1 100755
--- a/gcc/gcse.c
+++ b/gcc/gcse.c
@@ -1208,6 +1208,20 @@ want_to_gcse_p (x)
     case CALL:
       return 0;
 
+    case SYMBOL_REF:
+    case LABEL_REF:
+    case CONST:
+      if (flag_gcse_no_const)
+        return 0;
+      break;
+
+    case MEM:
+      if (flag_gcse_no_const && GET_CODE (XEXP (x, 0)) == SYMBOL_REF
+          && CONSTANT_POOL_ADDRESS_P (XEXP (x, 0))
+          && GET_CODE (get_pool_constant (XEXP (x, 0))) != CONST)
+        return 0;
+      break;
+
     default:
       break;
     }
