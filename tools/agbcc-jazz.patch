+   Matches the Jazz Jackrabbit compiler (Sprite_Init).  */
+static int exit_seen;
+static int *keep_uids, n_keep_uids, max_keep_uids;
+
+static void
+note_keep_giv (insn)
+     rtx insn;
+{
+  if (n_keep_uids == max_keep_uids)
+    {
+      max_keep_uids = max_keep_uids ? 2 * max_keep_uids : 64;
+      keep_uids = (int *) xrealloc (keep_uids, max_keep_uids * sizeof (int));
+    }
+  keep_uids[n_keep_uids++] = INSN_UID (insn);
+}
+
+static int
+keep_giv_p (insn)
